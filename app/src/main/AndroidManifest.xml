<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 阶段 4 使用：只分析音量，不保存原始音频。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ 展示前台服务通知时需要动态申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 阶段 5 使用：允许专注监测服务以前台服务运行。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 阶段 7 睡眠监测：整晚熄屏后仍需保持 CPU 运行采集传感器，普通权限，安装即授予。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 14 health 类型前台服务（睡眠只用体动、不用麦克风时）需要的权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- health 类型的运行时前置条件之一；普通权限无需弹窗，本 App 实际仍以低频采样。 -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!--
        智能闹钟：精确闹钟权限的官方推荐组合。
        Android 12/12L 使用 SCHEDULE_EXACT_ALARM（默认授予，用户可撤销）；
        Android 13+ 使用 USE_EXACT_ALARM（自动授予，但应用商店只允许闹钟/日历类 App 声明，上架前需评估）。
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 锁屏 / 熄屏时直接全屏弹出响铃页；Android 14+ 需要用户在设置中允许。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 响铃服务以 mediaPlayback 类型运行。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 响铃时振动，普通权限。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 特殊访问权限，不能通过普通运行时权限弹窗授予，需要引导用户前往系统设置；用于分心检测。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        分心检测需要：Android 11+ 的包可见性限制下，默认看不到其他 App。
        只声明"有桌面图标的 App"和"桌面本身"两类，用于显示分心 App 名称、排除桌面，
        不使用 QUERY_ALL_PACKAGES（权限过大，应用商店审核严格）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Hilt 要求 Application 使用 @HiltAndroidApp 的实现类。 -->
    <!--
        enableOnBackInvokedCallback：开启预测性返回。Android 14+ 上返回手势滑到一半就能预览上一页，
        Navigation Compose 会把 NavHost 里定义的返回转场变成可跟手拖动的动画；旧系统忽略此属性。
        项目里没有重写 onBackPressed，返回事件都走 OnBackPressedDispatcher，可以安全开启。
    -->
    <application
        android:name=".FocusGuardApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGuard">
        <!-- 允许基准测试读取发布构建的系统跟踪，同时保持应用不可调试。 -->
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <!-- App 唯一入口 Activity，负责承载 Compose UI。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="session"
                    android:scheme="focusguard" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".widget.FocusGuardWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_guard_widget_info" />
        </receiver>

        <!--
            阶段 5 的后台监测入口，不允许其他 App 直接启动。
            有麦克风权限时用 microphone；没有时用 health 兜底（Android 14+ 不允许无权限的 microphone 类型，会直接崩溃）。
        -->
        <service
            android:name=".service.FocusMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone|health" />

        <!-- 阶段 7 睡眠监测服务：体动用 health 类型，声音分析用 microphone 类型，运行时按权限组合。 -->
        <service
            android:name=".service.SleepMonitorService"
            android:exported="false"
            android:foregroundServiceType="health|microphone" />

        <!-- 智能闹钟：AlarmManager 触发入口，只接收本 App 的 PendingIntent。 -->
        <receiver
            android:name=".service.SleepAlarmReceiver"
            android:exported="false" />

        <!-- 智能闹钟：播放铃声和振动的前台服务。 -->
        <service
            android:name=".service.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            智能闹钟：响铃页。showWhenLocked / turnScreenOn 让它显示在锁屏上并点亮屏幕（8.1 以下在代码里用窗口标志）；
            独立任务栈 + 不进最近任务，避免关掉闹钟后把用户带回 App 首页。
        -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusGuard"
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <!-- 接收通知栏按钮点击事件。 -->
        <receiver
            android:name=".service.SessionActionReceiver"
            android:exported="false" />
    </application>

</manifest>
